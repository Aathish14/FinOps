# EditorConfig - https://editorconfig.org/
# Top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{py,toml,md,yml,yaml}]
indent_style = space
indent_size = 4

[*.{json,csv}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4
